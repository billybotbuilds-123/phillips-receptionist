<mjml>
<mj-head>
  <mj-title>Test notification</mj-title>
  <mj-attributes>
    <mj-all font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" />
    <mj-text line-height="1.55" font-size="16px" color="#2b2b2b" />
  </mj-attributes>
</mj-head>
<mj-body background-color="#f5f3ef">
  <mj-section background-color="#ffffff" padding="32px 24px" border-radius="12px">
    <mj-column>
      <mj-text font-size="14px" color="#6b6b68">Mr. Phillips Receptionist — System Test</mj-text>
      <mj-text font-size="18px" font-weight="500" color="#1a1a18" padding-top="8px">{{message}}</mj-text>
      <mj-text font-size="13px" color="#8a8a85">Sent at {{sent_at}}</mj-text>
    </mj-column>
  </mj-section>
</mj-body>
</mjml>
