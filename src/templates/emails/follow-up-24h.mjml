<mjml>
<mj-head>
  <mj-title>Just checking in — here's the scheduling link again</mj-title>
  <mj-preview>No pressure. Making sure you have it.</mj-preview>
  <mj-attributes>
    <mj-all font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" />
    <mj-text line-height="1.55" font-size="16px" color="#2b2b2b" />
    <mj-button background-color="#2b5cdc" color="#ffffff" border-radius="8px" font-size="16px" font-weight="500" padding="14px 24px" />
  </mj-attributes>
</mj-head>
<mj-body background-color="#f5f3ef">
  <mj-section background-color="#ffffff" padding="32px 24px 8px" border-radius="12px 12px 0 0">
    <mj-column>
      <mj-text font-size="14px" color="#6b6b68" padding-bottom="4px">Mr. Phillips's office</mj-text>
      <mj-text font-size="22px" font-weight="500" color="#1a1a18" padding-top="0">Hi {{parent_name}} —</mj-text>
    </mj-column>
  </mj-section>

  <mj-section background-color="#ffffff" padding="0 24px">
    <mj-column>
      <mj-text>
        Riley here, from Mr. Phillips's office. Just wanted to make sure yesterday's email didn't get buried — here's the scheduling link again:
      </mj-text>
      <mj-button href="{{calendly_url}}" align="left">Schedule your consultation</mj-button>
      <mj-text font-size="14px" color="#6b6b68">
        <a href="{{calendly_url}}" style="color:#2b5cdc;">{{calendly_url}}</a>
      </mj-text>
    </mj-column>
  </mj-section>

  <mj-section background-color="#ffffff" padding="8px 24px 24px">
    <mj-column>
      <mj-text color="#4a4a48" font-size="15px">
        No pressure — if now isn't the right moment, that's completely okay. The link stays good whenever you're ready. If you've decided it's not for you, just reply with "no thanks" and I won't write again.
      </mj-text>
    </mj-column>
  </mj-section>

  <mj-section background-color="#ffffff" padding="0 24px 24px" border-radius="0 0 12px 12px">
    <mj-column>
      <mj-text color="#1a1a18">Warmly,<br/>Riley<br/><span style="color:#6b6b68;font-size:14px;">at Mr. Phillips's office</span></mj-text>
    </mj-column>
  </mj-section>

  <mj-section padding="16px 24px">
    <mj-column>
      <mj-text font-size="12px" color="#8a8a85" align="center">
        Mr. Phillips's office · Long Beach, CA · <a href="tel:+15622704221" style="color:#8a8a85;">562-270-4221</a>
      </mj-text>
    </mj-column>
  </mj-section>
</mj-body>
</mjml>
