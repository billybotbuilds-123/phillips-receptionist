<mj-head>
  <mj-title>Yesterday at Mr. Phillips's office</mj-title>
  <mj-preview>{{call_count}} calls · {{booking_count}} booked · {{followup_count}} follow-ups queued</mj-preview>
  <mj-attributes>
    <mj-all font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" />
    <mj-text line-height="1.55" font-size="16px" color="#2b2b2b" />
  </mj-attributes>
</mj-head>
<mj-body background-color="#f5f3ef">
  <mj-section background-color="#ffffff" padding="28px 24px 8px" border-radius="12px 12px 0 0">
    <mj-column>
      <mj-text font-size="14px" color="#6b6b68" padding-bottom="4px">Daily summary · {{report_date_pt}}</mj-text>
      <mj-text font-size="22px" font-weight="500" color="#1a1a18" padding-top="0">Yesterday at a glance</mj-text>
    </mj-column>
  </mj-section>

  <mj-section background-color="#ffffff" padding="0 24px 16px">
    <mj-column width="25%">
      <mj-text align="center" font-size="28px" font-weight="500" color="#1a1a18">{{call_count}}</mj-text>
      <mj-text align="center" font-size="12px" color="#6b6b68">calls</mj-text>
    </mj-column>
    <mj-column width="25%">
      <mj-text align="center" font-size="28px" font-weight="500" color="#1a1a18">{{link_sent_count}}</mj-text>
      <mj-text align="center" font-size="12px" color="#6b6b68">links sent</mj-text>
    </mj-column>
    <mj-column width="25%">
      <mj-text align="center" font-size="28px" font-weight="500" color="#2b5cdc">{{booking_count}}</mj-text>
      <mj-text align="center" font-size="12px" color="#6b6b68">booked</mj-text>
    </mj-column>
    <mj-column width="25%">
      <mj-text align="center" font-size="28px" font-weight="500" color="#c84a2e">{{escalation_count}}</mj-text>
      <mj-text align="center" font-size="12px" color="#6b6b68">escalated</mj-text>
    </mj-column>
  </mj-section>

  <mj-section background-color="#ffffff" padding="0 24px 8px">
    <mj-column>
      <mj-divider border-color="#ece8df" border-width="1px" padding="0" />
      <mj-text font-size="17px" font-weight="500" color="#1a1a18" padding-top="16px">Revenue from yesterday's bookings</mj-text>
      <mj-text font-size="28px" font-weight="500" color="#1a1a18" padding-top="4px">${{revenue_dollars}}</mj-text>
      <mj-text font-size="13px" color="#6b6b68" padding-top="0">{{booking_count}} × ${{consultation_fee_dollars}}</mj-text>
    </mj-column>
  </mj-section>

  <mj-section background-color="#ffffff" padding="0 24px 16px">
    <mj-column>
      <mj-divider border-color="#ece8df" border-width="1px" padding="0" />
      <mj-text font-size="17px" font-weight="500" color="#1a1a18" padding-top="16px">Yesterday's calls</mj-text>
      <mj-text>{{calls_list_block}}</mj-text>
    </mj-column>
  </mj-section>

  <mj-section background-color="#ffffff" padding="0 24px 24px" border-radius="0 0 12px 12px">
    <mj-column>
      <mj-button background-color="#2b5cdc" color="#ffffff" border-radius="8px" font-size="15px" font-weight="500" padding="12px 20px" href="{{dashboard_url}}" align="left">Open dashboard</mj-button>
    </mj-column>
  </mj-section>
</mj-body>
