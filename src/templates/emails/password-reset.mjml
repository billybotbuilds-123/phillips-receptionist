<mjml>
<mj-head>
  <mj-title>Reset your password</mj-title>
  <mj-attributes>
    <mj-all font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" />
    <mj-text line-height="1.55" font-size="16px" color="#2b2b2b" />
    <mj-button background-color="#2b5cdc" color="#ffffff" border-radius="8px" font-size="16px" font-weight="500" padding="14px 24px" />
  </mj-attributes>
</mj-head>
<mj-body background-color="#f5f3ef">
  <mj-section background-color="#ffffff" padding="32px 24px 8px" border-radius="12px 12px 0 0">
    <mj-column>
      <mj-text font-size="14px" color="#6b6b68" padding-bottom="4px">Mr. Phillips Receptionist</mj-text>
      <mj-text font-size="22px" font-weight="500" color="#1a1a18" padding-top="0">Reset your password</mj-text>
    </mj-column>
  </mj-section>

  <mj-section background-color="#ffffff" padding="0 24px">
    <mj-column>
      <mj-text>Hi {{username}},</mj-text>
      <mj-text>Click the button below to reset your password. This link expires in 1 hour.</mj-text>
      <mj-button href="{{reset_url}}" align="left">Reset password</mj-button>
      <mj-text font-size="14px" color="#6b6b68">
        Or paste: <a href="{{reset_url}}" style="color:#2b5cdc;">{{reset_url}}</a>
      </mj-text>
    </mj-column>
  </mj-section>

  <mj-section background-color="#ffffff" padding="8px 24px 24px" border-radius="0 0 12px 12px">
    <mj-column>
      <mj-text font-size="14px" color="#6b6b68">
        If you didn't request this, ignore this email — your password hasn't changed.
      </mj-text>
    </mj-column>
  </mj-section>
</mj-body>
</mjml>
