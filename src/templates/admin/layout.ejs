<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title + ' — Riley Admin' : 'Riley Admin' %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css" />
  <style>
    :root { --pico-font-size: 15px; }
    body { min-height: 100vh; }
    .sidebar { width: 220px; min-height: 100vh; background: var(--pico-card-background-color); border-right: 1px solid var(--pico-muted-border-color); padding: 1.5rem 1rem; flex-shrink: 0; }
    .sidebar nav a { display: block; padding: 0.5rem 0.75rem; border-radius: var(--pico-border-radius); color: var(--pico-color); text-decoration: none; margin-bottom: 2px; }
    .sidebar nav a:hover, .sidebar nav a.active { background: var(--pico-primary-background); color: var(--pico-primary-inverse); }
    .main-layout { display: flex; }
    .main-content { flex: 1; padding: 2rem; max-width: 960px; }
    .badge { display: inline-block; padding: 0.2em 0.5em; border-radius: 4px; font-size: 0.75rem; font-weight: 600; }
    .badge-warning { background: #fef3cd; color: #856404; }
    .badge-danger { background: #f8d7da; color: #842029; }
    .badge-success { background: #d1e7dd; color: #0f5132; }
    .badge-info { background: #d0e4ff; color: #084298; }
    .top-banner { background: #fff3cd; border: 1px solid #ffc107; border-radius: 6px; padding: 0.75rem 1rem; margin-bottom: 1.5rem; }
    .top-banner a { color: inherit; font-weight: 600; }
    .stat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 1rem; margin-bottom: 2rem; }
    .stat-card { background: var(--pico-card-background-color); border: 1px solid var(--pico-muted-border-color); border-radius: 8px; padding: 1rem; text-align: center; }
    .stat-card .stat-value { font-size: 2rem; font-weight: 700; }
    .stat-card .stat-label { font-size: 0.8rem; color: var(--pico-muted-color); }
    table { width: 100%; }
    .inline-form { display: inline; }
    .reveal-field { font-family: monospace; letter-spacing: 0.05em; }
    .settings-layout { display: flex; gap: 2rem; }
    .settings-sidebar { width: 200px; flex-shrink: 0; }
    .settings-sidebar nav a { display: block; padding: 0.5rem 0.75rem; border-radius: var(--pico-border-radius); color: var(--pico-color); text-decoration: none; margin-bottom: 2px; }
    .settings-sidebar nav a:hover, .settings-sidebar nav a.active { background: var(--pico-primary-background); color: var(--pico-primary-inverse); }
    .settings-content { flex: 1; }
    .field-row { margin-bottom: 1.25rem; }
    .field-row .field-actions { display: flex; align-items: center; gap: 0.5rem; }
    .field-feedback { font-size: 0.85rem; margin-top: 0.25rem; }
    .field-feedback.error { color: var(--pico-del-color); }
    .field-feedback.success { color: #0f5132; }
    .missing-badge { font-size: 0.75rem; background: #fef3cd; color: #856404; padding: 0.1em 0.4em; border-radius: 4px; margin-left: 0.5rem; }
  </style>
</head>
<body>
<div class="main-layout">
  <aside class="sidebar">
    <div style="font-weight:700;font-size:1.1rem;margin-bottom:1.5rem;padding:0 0.75rem;">Riley Admin</div>
    <nav>
      <a href="/admin" class="<%= typeof currentPage !== 'undefined' && currentPage === 'dashboard' ? 'active' : '' %>">Dashboard</a>
      <a href="/admin/calls" class="<%= typeof currentPage !== 'undefined' && currentPage === 'calls' ? 'active' : '' %>">Calls</a>
      <a href="/admin/settings" class="<%= typeof currentPage !== 'undefined' && currentPage === 'settings' ? 'active' : '' %>">Settings</a>
    </nav>
    <div style="position:absolute;bottom:1.5rem;padding:0 0.75rem;font-size:0.8rem;color:var(--pico-muted-color);">
      <% if (typeof user !== 'undefined' && user) { %>
        Logged in as <%= user.username %><br/>
        <form action="/logout" method="POST" class="inline-form">
          <button type="submit" style="padding:0;background:none;border:none;color:var(--pico-primary);cursor:pointer;font-size:0.8rem;">Log out</button>
        </form>
      <% } %>
    </div>
  </aside>
  <main class="main-content">
    <%- body %>
  </main>
</div>
<script>
// Global settings save handler
document.addEventListener('DOMContentLoaded', () => {
  document.querySelectorAll('[data-save-key]').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      const key = btn.dataset.saveKey;
      const input = document.querySelector(`[data-key="${key}"]`);
      if (!input) return;
      const value = input.value;
      const feedback = document.querySelector(`[data-feedback="${key}"]`);
      btn.disabled = true;
      btn.textContent = 'Saving…';
      try {
        const resp = await fetch(`/admin/settings/${key}`, {
          method: 'POST',
          headers: {'Content-Type':'application/json'},
          body: JSON.stringify({value})
        });
        const data = await resp.json();
        if (resp.ok) {
          if (feedback) { feedback.textContent = '✓ Saved'; feedback.className = 'field-feedback success'; }
          setTimeout(() => { if (feedback) feedback.textContent = ''; }, 3000);
        } else {
          if (feedback) { feedback.textContent = data.message || data.error || 'Save failed'; feedback.className = 'field-feedback error'; }
        }
      } catch {
        if (feedback) { feedback.textContent = 'Network error'; feedback.className = 'field-feedback error'; }
      } finally {
        btn.disabled = false;
        btn.textContent = 'Save';
      }
    });
  });

  // Reveal button handler
  document.querySelectorAll('[data-reveal-key]').forEach(btn => {
    btn.addEventListener('click', async () => {
      const key = btn.dataset.revealKey;
      const input = document.querySelector(`[data-key="${key}"]`);
      if (!input) return;
      const resp = await fetch(`/admin/settings/reveal/${key}`);
      const data = await resp.json();
      input.value = data.value;
      btn.textContent = 'Hide';
      setTimeout(() => {
        const masked = data.value.length <= 4 ? '••••' : data.value.slice(0,6) + '••••••••••••' + data.value.slice(-4);
        input.value = masked;
        btn.textContent = 'Reveal';
      }, 10000);
    });
  });

  // Test connection handler
  document.querySelectorAll('[data-test-service]').forEach(btn => {
    btn.addEventListener('click', async () => {
      const service = btn.dataset.testService;
      const resultEl = document.querySelector(`[data-test-result="${service}"]`);
      btn.disabled = true;
      btn.textContent = 'Testing…';
      try {
        const resp = await fetch(`/admin/test-connection/${service}`, {method:'POST'});
        const data = await resp.json();
        if (resultEl) {
          resultEl.textContent = data.ok ? `✓ ${data.detail || 'Connected'} (${data.latency_ms}ms)` : `✗ ${data.error || 'Failed'}`;
          resultEl.style.color = data.ok ? '#0f5132' : '#842029';
        }
      } catch {
        if (resultEl) { resultEl.textContent = '✗ Network error'; resultEl.style.color = '#842029'; }
      } finally {
        btn.disabled = false;
        btn.textContent = 'Test connection';
      }
    });
  });
});
</script>
</body>
</html>
