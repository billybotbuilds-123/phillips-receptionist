<% locals.title = 'Dashboard'; locals.currentPage = 'dashboard'; %>

<% if (missingCount > 0) { %>
<div class="alert warning">
  <span class="alert-icon">⚠️</span>
  <div>
    <strong><%= missingCount %> setting<%= missingCount === 1 ? '' : 's' %> need configuration</strong> before Riley can send emails and SMS. &nbsp;
    <a href="/admin/settings/core-ai">Go to Settings →</a>
  </div>
</div>
<% } %>

<!-- Page header -->
<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.75rem;flex-wrap:wrap;gap:0.75rem;">
  <div>
    <h1 style="font-size:1.375rem;font-weight:700;margin-bottom:0.125rem;">Dashboard</h1>
    <p class="text-muted text-sm">Today, <%= new Date().toLocaleDateString('en-US', {timeZone:'America/Los_Angeles',weekday:'long',month:'long',day:'numeric'}) %></p>
  </div>
  <div class="riley-status">
    <span class="status-dot online"></span>Riley is live
  </div>
</div>

<!-- Stat row -->
<div class="stat-grid">
  <div class="stat-card">
    <div class="stat-label">Calls today</div>
    <div class="stat-value"><%= todayCalls %></div>
    <div class="stat-sub">inbound</div>
  </div>
  <div class="stat-card">
    <div class="stat-label">Links sent</div>
    <div class="stat-value blue"><%= todayLinksCount %></div>
    <div class="stat-sub">booking links</div>
  </div>
  <div class="stat-card">
    <div class="stat-label">Booked</div>
    <div class="stat-value green"><%= todayBookings %></div>
    <div class="stat-sub">consultations</div>
  </div>
  <div class="stat-card">
    <div class="stat-label">Escalations</div>
    <div class="stat-value <%= todayEscalations > 0 ? 'red' : '' %>"><%= todayEscalations %></div>
    <div class="stat-sub">urgent cases</div>
  </div>
  <div class="stat-card">
    <div class="stat-label">Est. revenue</div>
    <div class="stat-value green">$<%= todayRevenue %></div>
    <div class="stat-sub">from bookings</div>
  </div>
  <div class="stat-card">
    <div class="stat-label">Follow-ups due</div>
    <div class="stat-value <%= pendingFollowUps > 0 ? 'orange' : '' %>"><%= pendingFollowUps %></div>
    <div class="stat-sub">pending</div>
  </div>
</div>

<!-- Recent calls -->
<div class="card">
  <div class="card-header">
    <span class="card-title">Recent calls</span>
    <a href="/admin/calls" class="btn btn-secondary btn-sm">View all</a>
  </div>
  <% if (recentCalls.length === 0) { %>
    <div style="padding:2.5rem;text-align:center;color:var(--text2);">
      <div style="font-size:2.5rem;margin-bottom:0.75rem;">📞</div>
      <div style="font-weight:600;margin-bottom:0.25rem;">No calls yet</div>
      <div class="text-sm">Once Riley takes a call, it will appear here.</div>
    </div>
  <% } else { %>
  <div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th>Time</th>
        <th>Parent</th>
        <th>Child grade</th>
        <th>Urgency</th>
        <th>Status</th>
        <th>Links</th>
      </tr>
    </thead>
    <tbody>
    <% for (const call of recentCalls) { %>
      <tr>
        <td class="text-sm text-muted" style="white-space:nowrap;">
          <%= new Date(call.started_at).toLocaleString('en-US', {timeZone:'America/Los_Angeles',month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'}) %>
        </td>
        <td>
          <a href="/admin/calls/<%= call.id %>" style="font-weight:500;">
            <%= call.parent_name || '(unknown)' %>
          </a>
          <% if (call.flagged) { %>
            <span class="badge badge-danger" title="<%= call.flag_note || 'flagged' %>" style="margin-left:4px;">⚑</span>
          <% } %>
        </td>
        <td class="text-muted"><%= call.child_grade || '—' %></td>
        <td>
          <% if (call.urgency_level === 'crisis') { %>
            <span class="badge badge-purple">🚨 crisis</span>
          <% } else if (call.urgency_level === 'high') { %>
            <span class="badge badge-danger">high</span>
          <% } else if (call.urgency_level === 'medium') { %>
            <span class="badge badge-warning">medium</span>
          <% } else if (call.urgency_level === 'low') { %>
            <span class="badge badge-info">low</span>
          <% } else { %>
            <span class="text-muted">—</span>
          <% } %>
        </td>
        <td>
          <% if (call.booked_at) { %>
            <span class="badge badge-success">✓ booked</span>
          <% } else if (call.escalated) { %>
            <span class="badge badge-danger">escalated</span>
          <% } else { %>
            <span class="badge badge-gray">pending</span>
          <% } %>
        </td>
        <td style="white-space:nowrap;">
          <% if (call.doc_url) { %>
            <a href="<%= call.doc_url %>" target="_blank" rel="noopener" class="btn btn-secondary btn-sm">Doc</a>
          <% } %>
          <% if (call.recording_url) { %>
            <a href="<%= call.recording_url %>" target="_blank" rel="noopener" class="btn btn-secondary btn-sm">🎙</a>
          <% } %>
          <% if (!call.doc_url && !call.recording_url) { %><span class="text-muted">—</span><% } %>
        </td>
      </tr>
    <% } %>
    </tbody>
  </table>
  </div>
  <% } %>
</div>
