<% locals.title = 'Calls'; locals.currentPage = 'calls'; %>
<h2 style="margin-top:0;">All calls</h2>

<div style="overflow-x:auto;">
<table>
  <thead>
    <tr>
      <th>Time</th>
      <th>Parent</th>
      <th>Grade</th>
      <th>Urgency</th>
      <th>Duration</th>
      <th>Status</th>
    </tr>
  </thead>
  <tbody>
  <% for (const call of calls) { %>
    <tr>
      <td style="white-space:nowrap;font-size:0.85rem;"><%= new Date(call.started_at).toLocaleString('en-US', {timeZone:'America/Los_Angeles',month:'short',day:'numeric',year:'numeric',hour:'2-digit',minute:'2-digit'}) %></td>
      <td><a href="/admin/calls/<%= call.id %>"><%= call.parent_name || '(unknown)' %></a>
        <% if (call.flagged) { %> <span class="badge badge-danger" title="<%= call.flag_note || '' %>">⚑</span><% } %>
        <% if (call.escalated) { %> <span class="badge badge-danger">escalated</span><% } %>
      </td>
      <td><%= call.child_grade || '—' %></td>
      <td>
        <% const urgencyColors = {low:'badge-info',medium:'badge-warning',high:'badge-danger',crisis:'badge-danger'}; %>
        <% if (call.urgency_level) { %><span class="badge <%= urgencyColors[call.urgency_level] || '' %>"><%= call.urgency_level %></span><% } else { %>—<% } %>
      </td>
      <td><% if (call.duration_seconds) { %><%= Math.floor(call.duration_seconds/60) %>m <%= call.duration_seconds % 60 %>s<% } else { %>—<% } %></td>
      <td>
        <% if (call.booked_at) { %><span class="badge badge-success">booked</span>
        <% } else { %><span class="badge badge-warning">pending</span><% } %>
      </td>
    </tr>
  <% } %>
  </tbody>
</table>
</div>

<% if (totalPages > 1) { %>
<nav style="display:flex;gap:0.5rem;margin-top:1rem;">
  <% for (let p = 1; p <= totalPages; p++) { %>
    <a href="?page=<%= p %>" style="<%= p === page ? 'font-weight:bold;' : '' %>"><%= p %></a>
  <% } %>
</nav>
<% } %>
