<% locals.title = 'Call detail'; locals.currentPage = 'calls'; %>

<!-- Back nav -->
<div style="margin-bottom:1.25rem;">
  <a href="/admin/calls" style="color:var(--text2);text-decoration:none;font-size:13.5px;font-weight:500;">← Back to all calls</a>
</div>

<!-- Call header -->
<div style="display:flex;align-items:center;flex-wrap:wrap;gap:0.75rem;margin-bottom:1.75rem;">
  <h1 style="font-size:1.375rem;font-weight:700;margin:0;"><%= call.parent_name || 'Unknown caller' %></h1>
  <% if (call.urgency_level === 'crisis') { %>
    <span class="badge badge-purple" style="font-size:13px;">🚨 Crisis</span>
  <% } else if (call.urgency_level === 'high') { %>
    <span class="badge badge-danger" style="font-size:13px;">High urgency</span>
  <% } else if (call.urgency_level === 'medium') { %>
    <span class="badge badge-warning" style="font-size:13px;">Medium urgency</span>
  <% } else if (call.urgency_level === 'low') { %>
    <span class="badge badge-info" style="font-size:13px;">Low urgency</span>
  <% } %>
  <% if (call.escalated) { %><span class="badge badge-danger" style="font-size:13px;">Escalated</span><% } %>
  <% if (call.flagged) { %><span class="badge badge-danger" style="font-size:13px;">⚑ Flagged</span><% } %>
  <% if (call.booked_at) { %><span class="badge badge-success" style="font-size:13px;">✓ Booked</span><% } %>
</div>

<!-- Details grid -->
<div class="detail-grid">
  <div class="card">
    <div class="card-header"><span class="card-title">👤 Contact info</span></div>
    <div class="card-body">
      <table class="kv-table">
        <tr><th>Parent</th><td><%= call.parent_name || '—' %></td></tr>
        <tr><th>Email</th><td><% if (call.parent_email) { %><a href="mailto:<%= call.parent_email %>"><%= call.parent_email %></a><% } else { %>—<% } %></td></tr>
        <tr><th>Phone</th><td><% if (call.parent_phone) { %><a href="tel:<%= call.parent_phone %>"><%= call.parent_phone %></a><% } else { %>—<% } %></td></tr>
        <tr><th>Child</th><td><%= call.child_name || '—' %></td></tr>
        <tr><th>Grade</th><td><%= call.child_grade || '—' %></td></tr>
      </table>
    </div>
  </div>

  <div class="card">
    <div class="card-header"><span class="card-title">📊 Call metadata</span></div>
    <div class="card-body">
      <table class="kv-table">
        <tr><th>Started</th><td><%= new Date(call.started_at).toLocaleString('en-US', {timeZone:'America/Los_Angeles',dateStyle:'medium',timeStyle:'short'}) %></td></tr>
        <tr><th>Ended</th><td><%= call.ended_at ? new Date(call.ended_at).toLocaleString('en-US', {timeZone:'America/Los_Angeles',dateStyle:'medium',timeStyle:'short'}) : '—' %></td></tr>
        <tr><th>Duration</th><td><%= call.duration_seconds ? Math.floor(call.duration_seconds/60)+'m '+call.duration_seconds%60+'s' : '—' %></td></tr>
        <tr><th>Booked</th><td><%= call.booked_at ? new Date(call.booked_at).toLocaleString('en-US', {timeZone:'America/Los_Angeles',dateStyle:'medium',timeStyle:'short'}) : '—' %></td></tr>
        <tr><th>Escalation</th><td><%= call.escalation_reason || '—' %></td></tr>
        <tr><th>Vapi ID</th><td class="mono text-sm text-muted"><%= call.vapi_call_id || '—' %></td></tr>
      </table>
    </div>
  </div>
</div>

<!-- Summary -->
<% if (call.summary_of_need) { %>
<div class="card" style="margin-bottom:1.25rem;">
  <div class="card-header"><span class="card-title">📝 Summary of need</span></div>
  <div class="card-body">
    <p style="white-space:pre-wrap;font-size:13.5px;line-height:1.65;margin:0;"><%= call.summary_of_need %></p>
  </div>
</div>
<% } %>

<!-- Recording -->
<% if (call.recording_url) { %>
<div class="card" style="margin-bottom:1.25rem;">
  <div class="card-header"><span class="card-title">🎙 Recording</span></div>
  <div class="card-body">
    <audio controls src="<%= call.recording_url %>" style="width:100%;"></audio>
  </div>
</div>
<% } %>

<!-- Actions -->
<div class="card" style="margin-bottom:1.25rem;">
  <div class="card-header"><span class="card-title">⚡ Actions</span></div>
  <div class="card-body">
    <div style="display:flex;gap:0.75rem;flex-wrap:wrap;align-items:center;margin-bottom:1.25rem;">
      <% if (call.doc_url) { %>
        <a href="<%= call.doc_url %>" target="_blank" rel="noopener" class="btn btn-secondary">📄 Open Google Doc</a>
      <% } %>
      <button onclick="sendFollowUp('<%= call.id %>')" class="btn btn-secondary">📨 Send manual follow-up</button>
    </div>

    <div style="display:flex;gap:0.5rem;align-items:center;">
      <input type="text" id="flag-note" placeholder="Flag note (e.g. needs callback)" value="<%= call.flag_note || '' %>" style="flex:1;max-width:400px;" />
      <button onclick="flagCall('<%= call.id %>')" class="btn btn-secondary btn-sm">
        <% if (call.flagged) { %>✓ Update flag<% } else { %>⚑ Flag call<% } %>
      </button>
    </div>
  </div>
</div>

<!-- Messages sent -->
<div class="card" style="margin-bottom:1.25rem;">
  <div class="card-header"><span class="card-title">💬 Messages sent</span></div>
  <% if (call.messages && call.messages.length > 0) { %>
  <div class="table-wrap">
  <table>
    <thead><tr><th>Time</th><th>Channel</th><th>Template</th><th>Status</th></tr></thead>
    <tbody>
    <% for (const msg of call.messages) { %>
      <tr>
        <td class="text-sm text-muted"><%= new Date(msg.sent_at).toLocaleString('en-US', {timeZone:'America/Los_Angeles',dateStyle:'short',timeStyle:'short'}) %></td>
        <td><span class="badge badge-gray"><%= msg.channel %></span></td>
        <td class="text-muted"><%= msg.template %></td>
        <td>
          <% if (msg.status === 'sent' || msg.status === 'delivered') { %>
            <span class="badge badge-success"><%= msg.status %></span>
          <% } else { %>
            <span class="badge badge-danger"><%= msg.status %></span>
          <% } %>
        </td>
      </tr>
    <% } %>
    </tbody>
  </table>
  </div>
  <% } else { %>
  <div class="card-body" style="color:var(--text2);font-size:13.5px;">No messages logged for this call.</div>
  <% } %>
</div>

<!-- Transcript -->
<% if (call.raw_transcript) { %>
<div class="card">
  <div class="card-header">
    <span class="card-title">📃 Transcript</span>
  </div>
  <div class="card-body">
    <div class="transcript-box"><%= call.raw_transcript %></div>
  </div>
</div>
<% } %>

<script>
async function flagCall(id) {
  const note = document.getElementById('flag-note').value;
  const resp = await fetch(`/admin/calls/${id}/flag`, {
    method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({note})
  });
  if (resp.ok) window.location.reload();
}
async function sendFollowUp(id) {
  const btn = event.target;
  btn.disabled = true; btn.textContent = 'Sending…';
  const resp = await fetch(`/admin/calls/${id}/manual-follow-up`, {method:'POST'});
  btn.disabled = false;
  btn.textContent = resp.ok ? '✓ Sent!' : '✗ Failed';
}
</script>
