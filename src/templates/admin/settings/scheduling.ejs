<% locals.currentPage = 'settings'; locals.title = 'Scheduling'; %>
<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem;">
  <h2 style="margin:0;">Settings</h2>
  <small style="color:var(--pico-muted-color);">All changes are saved encrypted.</small>
</div>
<% if (missingCount > 0) { %>
<div class="top-banner">⚠️ <strong><%= missingCount %> setting<%= missingCount === 1 ? '' : 's' %> still need configuration</strong></div>
<% } %>
<div class="settings-layout">
  <div class="settings-sidebar"><%- include('./_nav') %></div>
  <div class="settings-content">

    <h3 style="margin-top:0;">Scheduling (Calendly)</h3>
    <p style="color:var(--pico-muted-color);font-size:0.9rem;">The $30 consultation fee is collected by Calendly's native Stripe integration at booking time.</p>

    <div class="field-row">
      <label>Calendly API token
        <% if (missingSettings.includes('calendly_api_token')) { %><span class="missing-badge">required</span><% } %>
      </label>
      <div class="field-actions">
        <input type="text" data-key="calendly_api_token" value="<%= tabData['calendly_api_token'] || '' %>" class="reveal-field" style="flex:1;font-family:monospace;" />
        <button type="button" data-reveal-key="calendly_api_token" class="secondary outline">Reveal</button>
        <button type="button" data-save-key="calendly_api_token">Save</button>
      </div>
      <div data-feedback="calendly_api_token" class="field-feedback"></div>
    </div>

    <div class="field-row">
      <label>Webhook signing key
        <% if (missingSettings.includes('calendly_webhook_signing_key')) { %><span class="missing-badge">required</span><% } %>
      </label>
      <div class="field-actions">
        <input type="text" data-key="calendly_webhook_signing_key" value="<%= tabData['calendly_webhook_signing_key'] || '' %>" class="reveal-field" style="flex:1;font-family:monospace;" />
        <button type="button" data-reveal-key="calendly_webhook_signing_key" class="secondary outline">Reveal</button>
        <button type="button" data-save-key="calendly_webhook_signing_key">Save</button>
      </div>
      <div data-feedback="calendly_webhook_signing_key" class="field-feedback"></div>
    </div>

    <div class="field-row">
      <label>Event type URI
        <% if (missingSettings.includes('calendly_event_type_uri')) { %><span class="missing-badge">required</span><% } %>
      </label>
      <div class="field-actions">
        <input type="text" data-key="calendly_event_type_uri" value="<%= tabData['calendly_event_type_uri'] || '' %>" placeholder="https://calendly.com/..." style="flex:1;" />
        <button type="button" data-save-key="calendly_event_type_uri">Save</button>
      </div>
      <div data-feedback="calendly_event_type_uri" class="field-feedback"></div>
    </div>

    <div style="display:flex;gap:0.75rem;flex-wrap:wrap;margin-top:1.5rem;align-items:center;">
      <button type="button" data-test-service="calendly">Test Calendly</button>
      <span data-test-result="calendly" style="font-size:0.85rem;"></span>
    </div>

  </div>
</div>
