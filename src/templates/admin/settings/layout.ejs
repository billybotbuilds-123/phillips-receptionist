<% locals.currentPage = 'settings'; %>
<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem;">
  <h2 style="margin:0;">Settings</h2>
  <small style="color:var(--pico-muted-color);">All changes are saved encrypted.</small>
</div>

<% if (missingCount > 0) { %>
<div class="top-banner">
  ⚠️ <strong><%= missingCount %> setting<%= missingCount === 1 ? '' : 's' %> need configuration</strong>
</div>
<% } %>

<div class="settings-layout">
  <div class="settings-sidebar">
    <nav>
      <% const tabs = [
        {slug:'core-ai',label:'Core AI'},
        {slug:'phone',label:'Phone & SMS'},
        {slug:'voice',label:'Voice'},
        {slug:'google',label:'Google'},
        {slug:'scheduling',label:'Scheduling'},
        {slug:'payments',label:'Payments'},
        {slug:'business-info',label:'Business Info'},
        {slug:'notifications',label:'Notifications'},
        {slug:'persona',label:"Riley's Persona"},
        {slug:'account',label:'Account'},
      ]; %>
      <% for (const t of tabs) { %>
        <a href="/admin/settings/<%= t.slug %>" class="<%= tab === t.slug ? 'active' : '' %>"><%= t.label %></a>
      <% } %>
      <hr style="margin:1rem 0;" />
      <a href="/admin/settings/audit" style="font-size:0.85rem;color:var(--pico-muted-color);">Audit log</a>
    </nav>
  </div>
  <div class="settings-content">
    <%- body %>
  </div>
</div>
