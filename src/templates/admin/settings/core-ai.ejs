<% locals.currentPage = 'settings'; %>
<% if (missingCount > 0) { %>
<div class="alert warning" style="margin-bottom:1.25rem;">
  <span class="alert-icon">⚠️</span>
  <strong><%= missingCount %> setting<%= missingCount === 1 ? '' : 's' %> need configuration.</strong>
  Required fields are marked below.
</div>
<% } %>
<div class="page-header">
  <h1 style="font-size:1.375rem;">Settings</h1>
  <p class="text-muted text-sm">Encrypted at rest (AES-256-GCM). Changes take effect immediately.</p>
</div>
<div class="settings-shell">
  <%- include('./_sidenav') %>
  <div class="settings-body">
<% locals.title = 'Core AI'; %>

<div class="card">
  <div class="card-header">
    <span class="card-title">🤖 Core AI</span>
  </div>
  <div class="card-body">
    <p class="text-muted text-sm" style="margin-bottom:1.5rem;">The Anthropic key pays for Riley's brain. Vapi connects the phone call to Claude. Both are required.</p>

    <div class="form-section">
      <div class="form-section-title">Anthropic</div>

      <div class="field">
        <label>
          Anthropic API key
          <% if (missingSettings.includes('anthropic_api_key')) { %><span class="required-badge">required</span><% } %>
        </label>
        <div class="field-row">
          <input type="text" data-key="anthropic_api_key" value="<%= tabData['anthropic_api_key'] || '' %>" class="mono" placeholder="sk-ant-api03-…" />
          <button type="button" class="btn btn-secondary btn-sm" data-reveal-key="anthropic_api_key" style="white-space:nowrap;">Reveal</button>
          <button type="button" class="btn btn-primary btn-sm" data-save-key="anthropic_api_key" style="white-space:nowrap;">Save</button>
        </div>
        <div data-feedback="anthropic_api_key" class="field-feedback"></div>
      </div>
    </div>

    <div class="form-section">
      <div class="form-section-title">Vapi</div>

      <div class="field">
        <label>
          Vapi API key
          <% if (missingSettings.includes('vapi_api_key')) { %><span class="required-badge">required</span><% } %>
        </label>
        <div class="field-row">
          <input type="text" data-key="vapi_api_key" value="<%= tabData['vapi_api_key'] || '' %>" class="mono" placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx" />
          <button type="button" class="btn btn-secondary btn-sm" data-reveal-key="vapi_api_key" style="white-space:nowrap;">Reveal</button>
          <button type="button" class="btn btn-primary btn-sm" data-save-key="vapi_api_key" style="white-space:nowrap;">Save</button>
        </div>
        <div data-feedback="vapi_api_key" class="field-feedback"></div>
      </div>

      <div class="field">
        <label>
          Vapi webhook secret
          <% if (missingSettings.includes('vapi_webhook_secret')) { %><span class="required-badge">required</span><% } %>
        </label>
        <div class="field-row">
          <input type="text" data-key="vapi_webhook_secret" value="<%= tabData['vapi_webhook_secret'] || '' %>" class="mono" />
          <button type="button" class="btn btn-secondary btn-sm" data-reveal-key="vapi_webhook_secret" style="white-space:nowrap;">Reveal</button>
          <button type="button" class="btn btn-primary btn-sm" data-save-key="vapi_webhook_secret" style="white-space:nowrap;">Save</button>
        </div>
        <div class="field-hint">Used to verify inbound webhooks from Vapi. Rotate if compromised.</div>
        <div data-feedback="vapi_webhook_secret" class="field-feedback"></div>
      </div>

      <div class="field">
        <label>
          Vapi MCP secret (Bearer token)
          <% if (missingSettings.includes('vapi_mcp_secret')) { %><span class="required-badge">required</span><% } %>
        </label>
        <div class="field-row">
          <input type="text" data-key="vapi_mcp_secret" value="<%= tabData['vapi_mcp_secret'] || '' %>" class="mono" />
          <button type="button" class="btn btn-secondary btn-sm" data-reveal-key="vapi_mcp_secret" style="white-space:nowrap;">Reveal</button>
          <button type="button" class="btn btn-primary btn-sm" data-save-key="vapi_mcp_secret" style="white-space:nowrap;">Save</button>
        </div>
        <div class="field-hint">Bearer token Vapi sends on MCP tool calls (<code>/mcp</code>). Set this value in Vapi's MCP tool "Authorization" header as <code>Bearer &lt;value&gt;</code>.</div>
        <div data-feedback="vapi_mcp_secret" class="field-feedback"></div>
      </div>
    </div>

    <div class="action-bar">
      <button type="button" class="btn btn-secondary" data-test-service="anthropic">Test Anthropic</button>
      <button type="button" class="btn btn-secondary" data-test-service="vapi">Test Vapi</button>
      <button type="button" class="btn btn-secondary" id="rotate-secret-btn">Rotate webhook secret</button>
      <span data-test-result="anthropic"></span>
      <span data-test-result="vapi"></span>
    </div>
    <div id="rotate-result" style="margin-top:0.75rem;font-family:monospace;font-size:12.5px;color:var(--text2);"></div>
  </div>
</div>

<script>
const csrf = () => document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '';
document.getElementById('rotate-secret-btn')?.addEventListener('click', async () => {
  const btn = document.getElementById('rotate-secret-btn');
  btn.disabled = true; btn.textContent = 'Rotating…';
  const resp = await fetch('/admin/settings/vapi/rotate-secret', {method:'POST', headers:{'X-CSRF-Token': csrf()}});
  const data = await resp.json();
  const el = document.getElementById('rotate-result');
  if (resp.ok) {
    el.textContent = '✓ New secret: ' + data.new_secret + '  — update this in Vapi dashboard (shown once only)';
    el.style.color = 'var(--success)';
  } else {
    el.textContent = '✗ Rotate failed'; el.style.color = 'var(--danger)';
  }
  btn.disabled = false; btn.textContent = 'Rotate webhook secret';
});
</script>
  </div>
</div>
