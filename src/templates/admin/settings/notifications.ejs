<% locals.currentPage = 'settings'; %>
<% if (missingCount > 0) { %>
<div class="alert warning" style="margin-bottom:1.25rem;">
  <span class="alert-icon">⚠️</span>
  <strong><%= missingCount %> setting<%= missingCount === 1 ? '' : 's' %> need configuration.</strong>
  Required fields are marked below.
</div>
<% } %>
<div class="page-header">
  <h1 style="font-size:1.375rem;">Settings</h1>
  <p class="text-muted text-sm">Encrypted at rest (AES-256-GCM). Changes take effect immediately.</p>
</div>
<div class="settings-shell">
  <%- include('./_sidenav') %>
  <div class="settings-body">
<% locals.title = 'Notifications'; %>

<div class="card">
  <div class="card-header">
    <span class="card-title">🔔 Notifications</span>
  </div>
  <div class="card-body">
    <p class="text-muted text-sm" style="margin-bottom:1.5rem;">Quiet hours delay <em>routine</em> follow-up messages. Crisis escalations and urgent callbacks are <strong>never delayed</strong> — they fire immediately regardless of quiet hours.</p>

    <div class="form-section">
      <div class="form-section-title">Your contact info (Shane)</div>

      <div class="field">
        <label>
          Notification email
          <% if (missingSettings.includes('shane_notification_email')) { %><span class="required-badge">required</span><% } %>
        </label>
        <div class="field-row">
          <input type="email" data-key="shane_notification_email" value="<%= tabData['shane_notification_email'] || '' %>" placeholder="EducationalSuccessExpert@gmail.com" />
          <button type="button" class="btn btn-primary btn-sm" data-save-key="shane_notification_email" style="white-space:nowrap;">Save</button>
        </div>
        <div data-feedback="shane_notification_email" class="field-feedback"></div>
      </div>

      <div class="field">
        <label>
          Notification phone (E.164)
          <% if (missingSettings.includes('shane_notification_phone')) { %><span class="required-badge">required</span><% } %>
        </label>
        <div class="field-row">
          <input type="text" data-key="shane_notification_phone" value="<%= tabData['shane_notification_phone'] || '' %>" placeholder="+15623015061" style="max-width:220px;" />
          <button type="button" class="btn btn-primary btn-sm" data-save-key="shane_notification_phone" style="white-space:nowrap;">Save</button>
        </div>
        <div class="field-hint">This is where Riley sends escalation SMS alerts.</div>
        <div data-feedback="shane_notification_phone" class="field-feedback"></div>
      </div>
    </div>

    <div class="form-section">
      <div class="form-section-title">Quiet hours</div>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
        <div class="field">
          <label>Start (HH:MM) <span class="optional-badge">optional</span></label>
          <div class="field-row">
            <input type="text" data-key="quiet_hours_start" value="<%= tabData['quiet_hours_start'] || '' %>" placeholder="22:00" style="max-width:120px;" />
            <button type="button" class="btn btn-primary btn-sm" data-save-key="quiet_hours_start">Save</button>
          </div>
          <div data-feedback="quiet_hours_start" class="field-feedback"></div>
        </div>
        <div class="field">
          <label>End (HH:MM) <span class="optional-badge">optional</span></label>
          <div class="field-row">
            <input type="text" data-key="quiet_hours_end" value="<%= tabData['quiet_hours_end'] || '' %>" placeholder="08:00" style="max-width:120px;" />
            <button type="button" class="btn btn-primary btn-sm" data-save-key="quiet_hours_end">Save</button>
          </div>
          <div data-feedback="quiet_hours_end" class="field-feedback"></div>
        </div>
      </div>
      <p class="text-muted text-sm" style="margin-top:0.25rem;">Leave both blank to disable quiet hours. Times are Pacific (America/Los_Angeles).</p>
    </div>

    <div class="action-bar">
      <button type="button" class="btn btn-secondary" id="test-notif-btn">Send test notification</button>
      <span id="test-notif-result" style="font-size:13px;"></span>
    </div>
  </div>
</div>

<script>
const csrf = () => document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '';
document.getElementById('test-notif-btn')?.addEventListener('click', async () => {
  const btn = document.getElementById('test-notif-btn');
  const el = document.getElementById('test-notif-result');
  btn.disabled = true; btn.textContent = 'Sending…';
  const resp = await fetch('/admin/test-notification', {method:'POST', headers:{'X-CSRF-Token': csrf()}});
  el.innerHTML = resp.ok
    ? '<span style="color:var(--success)">✓ Test notification sent!</span>'
    : '<span style="color:var(--danger)">✗ Send failed — check your phone/email settings.</span>';
  btn.disabled = false; btn.textContent = 'Send test notification';
});
</script>
  </div>
</div>
