<% locals.currentPage = 'settings'; %>
<% if (missingCount > 0) { %>
<div class="alert warning" style="margin-bottom:1.25rem;">
  <span class="alert-icon">⚠️</span>
  <strong><%= missingCount %> setting<%= missingCount === 1 ? '' : 's' %> need configuration.</strong>
  Required fields are marked below.
</div>
<% } %>
<div class="page-header">
  <h1 style="font-size:1.375rem;">Settings</h1>
  <p class="text-muted text-sm">Encrypted at rest (AES-256-GCM). Changes take effect immediately.</p>
</div>
<div class="settings-shell">
  <%- include('./_sidenav') %>
  <div class="settings-body">
<% locals.title = 'Account'; %>

<div class="card" style="max-width:480px;">
  <div class="card-header">
    <span class="card-title">🔒 Change password</span>
  </div>
  <div class="card-body">
    <form id="change-password-form">
      <div class="field">
        <label>Current password</label>
        <input type="password" id="current-password" required autocomplete="current-password" />
      </div>
      <div class="field">
        <label>New password <span style="color:var(--text3);font-weight:400;">(min 8 characters)</span></label>
        <input type="password" id="new-password" required minlength="8" autocomplete="new-password" />
      </div>
      <div class="field">
        <label>Confirm new password</label>
        <input type="password" id="confirm-password" required autocomplete="new-password" />
      </div>
      <button type="submit" class="btn btn-primary">Change password</button>
      <div id="password-result" style="margin-top:0.75rem;font-size:13px;min-height:16px;"></div>
    </form>
  </div>
</div>

<% if (typeof sessions !== 'undefined' && sessions.length > 0) { %>
<div class="card">
  <div class="card-header">
    <span class="card-title">🖥 Active sessions</span>
    <span class="text-muted text-sm"><%= sessions.length %> active</span>
  </div>
  <div class="table-wrap">
  <table>
    <thead><tr><th>Expires</th><th>IP address</th><th></th></tr></thead>
    <tbody>
    <% for (const s of sessions) { %>
      <tr>
        <td class="text-muted text-sm"><%= new Date(s.expires_at).toLocaleString('en-US', {timeZone:'America/Los_Angeles',dateStyle:'medium',timeStyle:'short'}) %></td>
        <td class="mono text-sm"><%= s.ip || '—' %></td>
        <td>
          <button type="button" class="btn btn-secondary btn-sm" onclick="revokeSession('<%= s.id %>')">Revoke</button>
        </td>
      </tr>
    <% } %>
    </tbody>
  </table>
  </div>
</div>
<% } %>

<% if (typeof loginActivity !== 'undefined' && loginActivity.length > 0) { %>
<div class="card">
  <div class="card-header">
    <span class="card-title">📋 Recent login activity</span>
  </div>
  <div class="table-wrap">
  <table>
    <thead><tr><th>Time</th><th>IP address</th><th>Result</th></tr></thead>
    <tbody>
    <% for (const a of loginActivity) { %>
      <tr>
        <td class="text-muted text-sm"><%= new Date(a.created_at).toLocaleString('en-US', {timeZone:'America/Los_Angeles',dateStyle:'medium',timeStyle:'short'}) %></td>
        <td class="mono text-sm"><%= a.ip || '—' %></td>
        <td>
          <% if (a.success) { %>
            <span class="badge badge-success">✓ success</span>
          <% } else { %>
            <span class="badge badge-danger">✗ failed</span>
          <% } %>
        </td>
      </tr>
    <% } %>
    </tbody>
  </table>
  </div>
</div>
<% } %>

<script>
const csrf = () => document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '';
document.getElementById('change-password-form')?.addEventListener('submit', async (e) => {
  e.preventDefault();
  const newPw = document.getElementById('new-password').value;
  const confirmPw = document.getElementById('confirm-password').value;
  const resultEl = document.getElementById('password-result');
  if (newPw !== confirmPw) {
    resultEl.innerHTML = '<span style="color:var(--danger)">Passwords do not match.</span>';
    return;
  }
  const resp = await fetch('/admin/account/change-password', {
    method: 'POST', headers: {'Content-Type':'application/json', 'X-CSRF-Token': csrf()},
    body: JSON.stringify({current_password: document.getElementById('current-password').value, new_password: newPw})
  });
  const data = await resp.json();
  resultEl.innerHTML = resp.ok
    ? '<span style="color:var(--success)">✓ Password changed successfully.</span>'
    : `<span style="color:var(--danger)">✗ ${data.message || 'Failed'}</span>`;
  if (resp.ok) e.target.reset();
});

async function revokeSession(id) {
  if (!confirm('Revoke this session?')) return;
  await fetch('/admin/account/revoke-session/' + id, {method:'POST', headers:{'X-CSRF-Token': csrf()}});
  window.location.reload();
}
</script>
  </div>
</div>
