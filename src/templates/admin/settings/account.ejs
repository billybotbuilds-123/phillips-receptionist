<% locals.currentPage = 'settings'; locals.title = 'Account'; %>
<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem;">
  <h2 style="margin:0;">Settings</h2>
  <small style="color:var(--pico-muted-color);">All changes are saved encrypted.</small>
</div>
<% if (missingCount > 0) { %>
<div class="top-banner">⚠️ <strong><%= missingCount %> setting<%= missingCount === 1 ? '' : 's' %> still need configuration</strong></div>
<% } %>
<div class="settings-layout">
  <div class="settings-sidebar"><%- include('./_nav') %></div>
  <div class="settings-content">

    <h3 style="margin-top:0;">Account</h3>

    <h4>Change password</h4>
    <form id="change-password-form" style="max-width:400px;">
      <label>Current password<input type="password" id="current-password" required /></label>
      <label>New password (min 8 chars)<input type="password" id="new-password" required minlength="8" /></label>
      <label>Confirm new password<input type="password" id="confirm-password" required /></label>
      <button type="submit">Change password</button>
      <div id="password-result" style="margin-top:0.5rem;font-size:0.85rem;"></div>
    </form>

    <% if (typeof sessions !== 'undefined' && sessions.length > 0) { %>
    <h4 style="margin-top:2rem;">Active sessions</h4>
    <table>
      <thead><tr><th>Expires</th><th>IP</th><th></th></tr></thead>
      <tbody>
      <% for (const s of sessions) { %>
        <tr>
          <td style="font-size:0.85rem;"><%= new Date(s.expires_at).toLocaleString('en-US', {timeZone:'America/Los_Angeles'}) %></td>
          <td style="font-size:0.85rem;"><%= s.ip || '—' %></td>
          <td><button type="button" onclick="revokeSession('<%= s.id %>')" class="secondary outline" style="padding:0.25rem 0.5rem;font-size:0.8rem;">Revoke</button></td>
        </tr>
      <% } %>
      </tbody>
    </table>
    <% } %>

    <% if (typeof loginActivity !== 'undefined' && loginActivity.length > 0) { %>
    <h4 style="margin-top:2rem;">Recent login activity</h4>
    <table>
      <thead><tr><th>Time</th><th>IP</th><th>Result</th></tr></thead>
      <tbody>
      <% for (const a of loginActivity) { %>
        <tr>
          <td style="font-size:0.85rem;"><%= new Date(a.created_at).toLocaleString('en-US', {timeZone:'America/Los_Angeles'}) %></td>
          <td style="font-size:0.85rem;"><%= a.ip %></td>
          <td><span class="badge <%= a.success ? 'badge-success' : 'badge-danger' %>"><%= a.success ? 'success' : 'failed' %></span></td>
        </tr>
      <% } %>
      </tbody>
    </table>
    <% } %>

  </div>
</div>
<script>
document.getElementById('change-password-form')?.addEventListener('submit', async (e) => {
  e.preventDefault();
  const newPw = document.getElementById('new-password').value;
  const confirmPw = document.getElementById('confirm-password').value;
  const resultEl = document.getElementById('password-result');
  if (newPw !== confirmPw) {
    if (resultEl) resultEl.textContent = 'Passwords do not match.';
    return;
  }
  const resp = await fetch('/admin/account/change-password', {
    method: 'POST',
    headers: {'Content-Type': 'application/json'},
    body: JSON.stringify({
      current_password: document.getElementById('current-password').value,
      new_password: newPw
    })
  });
  const data = await resp.json();
  if (resultEl) resultEl.textContent = resp.ok ? '✓ Password changed.' : '✗ ' + (data.message || 'Failed');
});

async function revokeSession(id) {
  await fetch('/admin/account/revoke-session/' + id, {method: 'POST'});
  window.location.reload();
}
</script>
