<% locals.currentPage = 'settings'; locals.title = 'Business Info'; %>
<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem;">
  <h2 style="margin:0;">Settings</h2>
  <small style="color:var(--pico-muted-color);">All changes are saved encrypted.</small>
</div>
<% if (missingCount > 0) { %>
<div class="top-banner">⚠️ <strong><%= missingCount %> setting<%= missingCount === 1 ? '' : 's' %> still need configuration</strong></div>
<% } %>
<div class="settings-layout">
  <div class="settings-sidebar"><%- include('./_nav') %></div>
  <div class="settings-content">

    <h3 style="margin-top:0;">Business Info</h3>
    <p style="color:var(--pico-muted-color);font-size:0.9rem;">Business data Riley references on calls; email templates use these values.</p>

    <div class="field-row">
      <label>Consultation fee (cents)
        <% if (missingSettings.includes('consultation_fee_cents')) { %><span class="missing-badge">required</span><% } %>
      </label>
      <div class="field-actions">
        <input type="number" data-key="consultation_fee_cents" value="<%= tabData['consultation_fee_cents'] || '' %>" min="0" step="1" style="flex:1;" />
        <button type="button" data-save-key="consultation_fee_cents">Save</button>
      </div>
      <small style="color:var(--pico-muted-color);">3000 = $30.00</small>
      <div data-feedback="consultation_fee_cents" class="field-feedback"></div>
    </div>

    <div class="field-row">
      <label>Consultation duration (minutes)
        <% if (missingSettings.includes('consultation_duration_minutes')) { %><span class="missing-badge">required</span><% } %>
      </label>
      <div class="field-actions">
        <input type="number" data-key="consultation_duration_minutes" value="<%= tabData['consultation_duration_minutes'] || '15' %>" min="1" max="180" style="flex:1;" />
        <button type="button" data-save-key="consultation_duration_minutes">Save</button>
      </div>
      <div data-feedback="consultation_duration_minutes" class="field-feedback"></div>
    </div>

    <div class="field-row">
      <label>Timezone
        <% if (missingSettings.includes('timezone')) { %><span class="missing-badge">required</span><% } %>
      </label>
      <div class="field-actions">
        <input type="text" data-key="timezone" value="<%= tabData['timezone'] || 'America/Los_Angeles' %>" placeholder="America/Los_Angeles" style="flex:1;" />
        <button type="button" data-save-key="timezone">Save</button>
      </div>
      <div data-feedback="timezone" class="field-feedback"></div>
    </div>

    <div class="field-row">
      <label>Mr. Phillips's bio
        <% if (missingSettings.includes('mr_phillips_bio')) { %><span class="missing-badge">required</span><% } %>
      </label>
      <textarea data-key="mr_phillips_bio" rows="5" style="width:100%;" placeholder="Mr. Phillips has 14 years of experience…"><%= tabData['mr_phillips_bio'] || '' %></textarea>
      <div style="display:flex;gap:0.5rem;margin-top:0.5rem;">
        <button type="button" data-save-key="mr_phillips_bio">Save</button>
        <button type="button" id="preview-affirmation-btn" class="secondary">Preview Riley's affirmation</button>
      </div>
      <div data-feedback="mr_phillips_bio" class="field-feedback"></div>
    </div>

    <div id="affirmation-preview" style="background:var(--pico-card-background-color);border:1px solid var(--pico-muted-border-color);border-radius:6px;padding:1rem;margin-top:1rem;display:none;"></div>

  </div>
</div>
<script>
document.getElementById('preview-affirmation-btn')?.addEventListener('click', async (e) => {
  const btn = e.currentTarget;
  btn.disabled = true; btn.textContent = 'Generating…';
  const resp = await fetch('/admin/settings/persona/affirmation-preview', {method:'POST'});
  const data = await resp.json();
  const container = document.getElementById('affirmation-preview');
  if (container) {
    container.style.display = '';
    container.innerHTML = '<strong>Example affirmations Riley might say:</strong><ul>' +
      (data.lines || []).map((l) => '<li>' + l + '</li>').join('') + '</ul>';
  }
  btn.disabled = false; btn.textContent = "Preview Riley's affirmation";
});
</script>
