<% locals.currentPage = 'settings'; %>
<% if (missingCount > 0) { %>
<div class="alert warning" style="margin-bottom:1.25rem;">
  <span class="alert-icon">⚠️</span>
  <strong><%= missingCount %> setting<%= missingCount === 1 ? '' : 's' %> need configuration.</strong>
  Required fields are marked below.
</div>
<% } %>
<div class="page-header">
  <h1 style="font-size:1.375rem;">Settings</h1>
  <p class="text-muted text-sm">Encrypted at rest (AES-256-GCM). Changes take effect immediately.</p>
</div>
<div class="settings-shell">
  <%- include('./_sidenav') %>
  <div class="settings-body">
<% locals.title = 'Business Info'; %>

<div class="card">
  <div class="card-header">
    <span class="card-title">🏢 Business Info</span>
  </div>
  <div class="card-body">
    <p class="text-muted text-sm" style="margin-bottom:1.5rem;">Riley references these values on calls and in all email templates. Keep them accurate.</p>

    <div class="form-section">
      <div class="form-section-title">Pricing & availability</div>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
        <div class="field">
          <label>
            Consultation fee (cents)
            <% if (missingSettings.includes('consultation_fee_cents')) { %><span class="required-badge">required</span><% } %>
          </label>
          <div class="field-row">
            <input type="number" data-key="consultation_fee_cents" value="<%= tabData['consultation_fee_cents'] || '' %>" min="0" step="1" placeholder="3000" style="max-width:140px;" />
            <button type="button" class="btn btn-primary btn-sm" data-save-key="consultation_fee_cents" style="white-space:nowrap;">Save</button>
          </div>
          <div class="field-hint">3000 = $30.00</div>
          <div data-feedback="consultation_fee_cents" class="field-feedback"></div>
        </div>

        <div class="field">
          <label>
            Session duration (minutes)
            <% if (missingSettings.includes('consultation_duration_minutes')) { %><span class="required-badge">required</span><% } %>
          </label>
          <div class="field-row">
            <input type="number" data-key="consultation_duration_minutes" value="<%= tabData['consultation_duration_minutes'] || '15' %>" min="1" max="180" style="max-width:100px;" />
            <button type="button" class="btn btn-primary btn-sm" data-save-key="consultation_duration_minutes" style="white-space:nowrap;">Save</button>
          </div>
          <div data-feedback="consultation_duration_minutes" class="field-feedback"></div>
        </div>
      </div>

      <div class="field">
        <label>
          Timezone
          <% if (missingSettings.includes('timezone')) { %><span class="required-badge">required</span><% } %>
        </label>
        <div class="field-row">
          <input type="text" data-key="timezone" value="<%= tabData['timezone'] || 'America/Los_Angeles' %>" placeholder="America/Los_Angeles" style="max-width:280px;" />
          <button type="button" class="btn btn-primary btn-sm" data-save-key="timezone" style="white-space:nowrap;">Save</button>
        </div>
        <div class="field-hint">IANA timezone name. All call times and quiet hours use this zone.</div>
        <div data-feedback="timezone" class="field-feedback"></div>
      </div>
    </div>

    <div class="form-section">
      <div class="form-section-title">Mr. Phillips's bio</div>

      <div class="field">
        <label>
          Bio text
          <% if (missingSettings.includes('mr_phillips_bio')) { %><span class="required-badge">required</span><% } %>
        </label>
        <textarea data-key="mr_phillips_bio" rows="6" placeholder="Mr. Phillips has 14 years of experience as a special education parent advocate in Long Beach, CA…"><%= tabData['mr_phillips_bio'] || '' %></textarea>
        <div class="field-hint">Riley uses this to reassure parents and generate warm, factual affirmations about Shane's expertise.</div>
        <div data-feedback="mr_phillips_bio" class="field-feedback"></div>
        <div style="display:flex;gap:0.5rem;margin-top:0.75rem;">
          <button type="button" class="btn btn-primary btn-sm" data-save-key="mr_phillips_bio">Save bio</button>
          <button type="button" class="btn btn-secondary btn-sm" id="preview-affirmation-btn">Preview Riley's affirmation →</button>
        </div>
      </div>

      <div id="affirmation-preview" style="display:none;background:var(--primary-bg);border:1px solid #bfdbfe;border-radius:var(--radius);padding:1rem 1.125rem;margin-top:0.75rem;">
        <div style="font-size:12px;font-weight:600;color:var(--primary);margin-bottom:0.5rem;text-transform:uppercase;letter-spacing:.05em;">Example affirmations Riley might say:</div>
        <div id="affirmation-lines" style="font-size:13.5px;line-height:1.7;"></div>
      </div>
    </div>
  </div>
</div>

<script>
document.getElementById('preview-affirmation-btn')?.addEventListener('click', async (e) => {
  const btn = e.currentTarget;
  btn.disabled = true; btn.textContent = 'Generating…';
  const resp = await fetch('/admin/settings/persona/affirmation-preview', {method:'POST'});
  const data = await resp.json();
  const container = document.getElementById('affirmation-preview');
  const lines = document.getElementById('affirmation-lines');
  if (container && lines) {
    lines.innerHTML = (data.lines || []).map(l => `<div style="padding:3px 0;">• ${l}</div>`).join('');
    container.style.display = '';
  }
  btn.disabled = false; btn.textContent = "Preview Riley's affirmation →";
});
</script>
  </div>
</div>
